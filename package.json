{
  "name": "piano-typing-game",
  "private": true,
  "version": "2.0.0",
  "description": "A 6K piano typing game simulator built with modern web technologies",
  "type": "module",
  "scripts": {
    "dev": "npm run lint && vite",
    "build": "npm run lint && vite build",
    "lint": "eslint src/js/**/*.js --fix && prettier --write src/js/**/*.js src/css/**/*.css *.html"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "vite": "^6.3.5"
  }
}